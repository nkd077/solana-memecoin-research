# ==== Режим работы ====
# true = ничего не покупается по-настоящему, только логи (безопасно по умолчанию)
DRY_RUN=true

# ==== Solana RPC (Helius) ====
HELIUS_API_KEY=

# ==== Кошелёк исполнения ====
# Приватный ключ в формате base58 (как при экспорте из Phantom).
# НИКОГДА не коммитьте .env с реальным ключом в git!
PRIVATE_KEY=

# ==== Внешние API источники сигналов ====
ARKHAM_API_KEY=
GMGN_API_KEY=
BIRDEYE_API_KEY=

# ==== GMGN WebSocket (см. README — раздел "Известные ограничения GMGN") ====
GMGN_WS_URL=wss://gmgn.ai/ws
# Опциональный токен для защищённых каналов (Аккаунт -> Настройки -> API token на gmgn.ai)
GMGN_ACCESS_TOKEN=
# Профиль TLS-отпечатка для curl_cffi, нужен чтобы обойти блокировку Cloudflare
GMGN_IMPERSONATE=chrome124
# Версия фронтенда GMGN на момент написания кода — САМОЕ ХРУПКОЕ место,
# может устареть. Актуальное значение смотрите в DevTools браузера (вкладка
# Network -> WS -> query-параметр app_ver запроса к wss://gmgn.ai/ws)
GMGN_APP_VER=20260202-10623-98faccb
GMGN_APP_LANG=en-US
GMGN_TZ_NAME=Europe/Moscow
GMGN_TZ_OFFSET=10800
# Список адресов кошельков-китов через запятую — GMGN отдаёт сделки только
# по заранее заданному списку, а не общий поток по всей сети. Соберите
# адреса на https://gmgn.ai/rank или через Arkham.
GMGN_WATCH_WALLETS=

# ==== Jito ====
JITO_TIP_LAMPORTS=10000

# ==== Redis (кэш кошельков, кластеров, позиций) ====
REDIS_URL=redis://localhost:6379/0

# ==== Логирование ====
# DEBUG полезен, чтобы увидеть сырые сообщения от GMGN и подобрать под них парсер
LOG_LEVEL=INFO

# ==== Скоринг ====
SCORE_THRESHOLD=0.65

# ==== Автообнаружение инсайдеров напрямую из блокчейна (основной источник) ====
# Программа, которую сканируем (по умолчанию Pump.fun)
CHAIN_SCAN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
CHAIN_SCAN_POLL_INTERVAL_SEC=15
# Не рассматривать покупки мельче этого объёма (шум/дасты)
MIN_BUY_SOL_TO_CONSIDER=0.3
MINT_SEEN_TTL_SEC=86400
# Через сколько МИНУТ проверять исход: 30 минут ловит РЕАЛЬНЫХ рано входящих,
# 120+ минут ловит везунчиков и шум (в первые часы после Pump.fun рост часто неправдоподобный)
OUTCOME_CHECK_DELAY_MIN=30
OUTCOME_CHECK_INTERVAL_SEC=300
# Рост цены, считаемый "победой": 2.0 = 200% (3x от входа).
# 0.5 = 50% даёт слишком много ложных срабатываний — вместо инсайдеров ловишь везунчиков
OUTCOME_WIN_THRESHOLD_PCT=2.0
# Минимум отслеженных исходов для доверия winrate кошелька.
# 3 = слишком мало (может быть случайность). 20 = лучше верить.
MIN_TRADES_FOR_TRUSTED_WINRATE=20
# Порог winrate: 0.55 это почти монета (50%). 0.65+ это реальный навык.
SMART_MONEY_MIN_WINRATE=0.65

# ==== Фильтр кластеризации (шум vs реальные сигналы) ====
# Не рассматривать сделку, если её купило меньше стольких РАЗНЫХ кошельков
# за 30 мин. 1 = без фильтра (каждая покупка = сигнал). 5 = нужны 5 кошельков
# (отсеивает одиночные везунчики, ловит реальный интерес).
MIN_CLUSTER_SIZE_TO_CONSIDER=5

# ==== Скрининг кошельков против скам/дев-паттернов (core/wallet_screener.py) ====
# Применяется ДО скоринга — жёстко исключает шумовые/скам-сигналы, а не
# просто снижает их вес
WALLET_SCREENING_ENABLED=true
# Кошелёк младше этого числа дней не может получить статус "проверенного"
# смарт-мани (не блокирует сделку, только не даёт репутации накопиться раньше времени)
MIN_WALLET_AGE_DAYS=1.0
# Если кошелёк купил больше стольких РАЗНЫХ новых токенов за сутки — это
# спрей-бот/фермер объёма, а не селективный инсайдер. Такой кошелёк
# полностью исключается из рассмотрения на сегодня (жёсткий блок)
MAX_NEW_MINTS_PER_WALLET_PER_DAY=8
WALLET_SCREEN_CACHE_TTL_SEC=86400
# Как долго кошелёк остаётся в блок-листе после обнаружения скам-паттерна
# (по умолчанию 180 дней — намеренно долго)
BLOCKLIST_TTL_SEC=15552000
# Winrate, ниже которого кошелёк (накопивший минимум MIN_TRADES_FOR_TRUSTED_WINRATE
# исходов) автоматически блокируется — симметрично статусу смарт-мани
BAD_WALLET_BLOCKLIST_WINRATE=0.15

# ==== Rug-check перед покупкой (core/rug_checker.py) ====
# Проверка mint/freeze-authority (может ли создатель печатать токены или
# заморозить счета) и концентрации держателей — жёсткий гейт ТОЛЬКО на
# саму покупку (не на отслеживание/обучение репутации кошельков)
RUG_CHECK_ENABLED=true
# --- Исполнимость сделки на бондинг-кривой ---
# Единый порог "ликвидность в $" измеряет НЕ ТО: у Pump.fun цена считается
# по виртуальным резервам (старт ~30 SOL), поэтому вход на 0.1 SOL стоит
# 0.1-0.3% даже у токена с $80 реальной ликвидности. Проверено на живых
# данных. Разделено на два независимых вопроса:
#
#   1) сколько теряем на входе — проскальзывание = позиция / виртуальные резервы
MAX_ENTRY_SLIPPAGE_PCT=0.02
#   2) сможем ли выйти — реального SOL в кривой должно хватить, чтобы нам
#      заплатили при продаже (в N раз больше позиции)
MIN_EXIT_LIQUIDITY_MULTIPLE=15.0
#
# Грубый порог остаётся только как проверка "токен вообще жив" — ниже него
# в кривой почти нет реального SOL. НЕ применяется к отслеживанию новых
# токенов, только к реальной покупке.
MIN_LIQUIDITY_USD_TO_BUY=300.0

# ==== Автоматический выход из позиций ====
# Проверка открытых позиций раз в столько секунд
POSITION_CHECK_INTERVAL_SEC=20
# Стоп-лосс: падение цены от входа — закрывает позицию полностью, работает всегда
STOP_LOSS_PCT=0.3

# Тейк-профит теперь ЛЕСТНИЦА частичных фиксаций, а не потолок в 1 икс.
# Это позволяет не резать монеты, которые могут дать 20x-100x: часть позиции
# фиксируется на разумных иксах, а остаток едет дальше без ограничения сверху.
# Уровень 1: при таком росте (множитель к цене входа) продать такую долю ОСТАВШЕЙСЯ позиции
PARTIAL_TP_1_MULTIPLE=2.0
PARTIAL_TP_1_FRACTION=0.5
# Уровень 2: следующий рубеж, тоже продаём долю от того, что осталось после уровня 1
PARTIAL_TP_2_MULTIPLE=5.0
PARTIAL_TP_2_FRACTION=0.5
# Трейлинг-стоп включается ТОЛЬКО после первой частичной фиксации (уровень 1),
# чтобы не срезать позицию на обычной волатильности до того, как рост
# подтверждён хотя бы одной частичной продажей. Считается от пика цены.
TRAILING_ACTIVATE_PCT=0.3
TRAILING_STOP_PCT=0.15
# Принудительное закрытие остатка, если позиция висит слишком долго
MAX_HOLD_MINUTES=180

# ==== Управление рисками ====
MIN_POSITION_SOL=0.01
MAX_POSITION_SOL=0.5
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_WHALE=1
DAILY_STOP_LOSS_PCT=0.10
MAX_POOL_SHARE_PCT=0.02
SLIPPAGE_BPS=300

# --- SQLite ---
DB_PATH=data/sniper.db

# --- Telegram (алерты /status /pause /approve) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVE_REQUIRED=false
TELEGRAM_APPROVE_TIMEOUT_SEC=60

# --- Dashboard http://127.0.0.1:8787/ ---
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# --- Executor: auto | pump | jito ---
EXECUTOR_MODE=auto

# --- Insider: funding cluster (phase v2 defaults) ---
INSIDER_DETECT_ENABLED=true
INSIDER_MAX_WALLET_AGE_HOURS=12
INSIDER_MIN_SHARED_FUNDER=3
INSIDER_MAX_FUNDER_FANOUT=12
INSIDER_FORCE_PASS=false
INSIDER_EXPERIMENT_PHASE=v2
INSIDER_EXPERIMENT_MAX_SIGNALS=200
INSIDER_MIN_MINT_AGE_SEC=300
INSIDER_REQUIRE_MARKET_ALIVE=true
INSIDER_DEMO_PAPER=true
INSIDER_DEMO_MAX_SIGNALS=200
INSIDER_STOP_LOSS_PCT=0.35
INSIDER_PARTIAL_TP_1_MULTIPLE=3.0
INSIDER_PARTIAL_TP_1_FRACTION=0.4
INSIDER_PARTIAL_TP_2_MULTIPLE=6.0
INSIDER_PARTIAL_TP_2_FRACTION=0.5
INSIDER_TRAILING_ACTIVATE_PCT=0.4
INSIDER_TRAILING_STOP_PCT=0.2
INSIDER_MAX_HOLD_MINUTES=45
HELIUS_RPC_MAX_PER_MIN=20
HELIUS_RPC_COOLDOWN_SEC=600
INSIDER_MAX_RPC_PER_MINT=6
INSIDER_MAX_RPC_ATTEMPTS_PER_MINT=36
INSIDER_MAX_SIG_PAGES=3
INSIDER_MIN_BUYERS_BEFORE_RPC=3
WALLET_SCREEN_AGE_RPC=false

# Accumulation shadow (не early sniper) + DexScreener catalyst proxy
ACCUM_SHADOW_ENABLED=true
ACCUM_BUY_ENABLED=false
ACCUM_MIN_MINT_AGE_SEC=300
ACCUM_WINDOW_SEC=3600
ACCUM_REPEAT_WALLET_BUYS=2
ACCUM_REPEAT_MIN_SOL_TOTAL=1.0
ACCUM_CLUSTER_WALLETS=3
ACCUM_CLUSTER_MIN_SOL_EACH=0.5
ACCUM_OUTCOME_DELAY_MIN=60
CATALYST_DEXSCREENER_ENABLED=true
CATALYST_MAX_PER_MIN=6

# --- Три режима сразу (lab / honest / experiment) ---
# score | insider | hybrid — hybrid = score ИЛИ insider-кластер
ENTRY_MODE=hybrid
# В DRY_RUN резать score-путь тем же edge, что и live (честная бумага)
ENFORCE_EDGE_GATE=true
# false = не зеркалить продажу кита (только TP/SL/trailing/max_hold)
WHALE_MIRROR_EXIT=true

# --- Smart money feed (файл + proven из кэша) ---
SMART_MONEY_FILE=data/smart_money_wallets.txt
SMART_MONEY_SYNC_SEC=120

# --- Health alerts ---
HEALTH_ALERT_WS_GAP_SEC=90
HEALTH_HELIUS_429_THRESHOLD=10

# --- verify_live.py --live-dust ---
LIVE_VERIFY_MINT=
LIVE_VERIFY_SOL=0.01
